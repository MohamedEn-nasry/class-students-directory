{
  "ConnectionStrings": {
    // Supabase pooler connection string (Session/Transaction mode, port 6543).
    // Set as env var instead of committing secrets:
    //   ConnectionStrings__Supabase="Host=aws-0-eu-central-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.xxxxx;Password=***;Pooling=true;SSL Mode=Require;Trust Server Certificate=true"
    "Supabase": "Host=aws-0-xxx.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.xxxxx;Password=REPLACE_ME;Pooling=true;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Database": {
    "DisablePreparedStatements": true
  },
  "Cors": {
    // Production frontend origin(s). No wildcard — exact origins only.
    "AllowedOrigins": ["https://your-frontend.example.com"]
  },
  "IpHashing": {
    // Long random secret. Env var: IpHashing__Salt
    "Salt": "REPLACE_WITH_32_PLUS_RANDOM_CHARS"
  },
  "RateLimit": {
    "PostsPerHour": 5
  },
  "Turnstile": {
    "Enabled": false,
    "SecretKey": "REPLACE_ME_IF_ENABLED",
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  }
}
